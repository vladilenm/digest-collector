# Read-only source: SELECT on digest.published_issue_source, no producer credentials.
DIGEST_DATABASE_URL=
DIGEST_DATABASE_SSL=require
DIGEST_DATABASE_NETWORK=remote
DIGEST_TOPIC_ID=ai

# Separate runtime role: SELECT/INSERT/UPDATE on newsletter.unisender_campaigns.
NEWSLETTER_DATABASE_URL=
NEWSLETTER_DATABASE_SSL=require
NEWSLETTER_DATABASE_NETWORK=remote
# Owner credential for a one-off migration only. Never set on the running worker.
NEWSLETTER_MIGRATION_URL=

UNISENDER_API_KEY=
UNISENDER_LIST_ID=
UNISENDER_FROM_EMAIL=digest@irreplaceable-ai.ru
UNISENDER_FROM_NAME="Владилен Минин · Незаменимые"
# YYYY-MM-DD, first common send date in Europe/Moscow. No default date.
UNISENDER_FIRST_SEND_DATE=
UNISENDER_CAMPAIGNS_ENABLED=false
UNISENDER_ACCOUNT_READY=false
UNISENDER_PUBLIC_DELIVERY_ENABLED=false
# Test delivery accepts only this address. Public delivery requires an empty
# value AND UNISENDER_PUBLIC_DELIVERY_ENABLED=true after the delivery test.
NEWSLETTER_TEST_RECIPIENT=digest@irreplaceable-ai.ru

# Disposable local test database only; its name must end in _test.
NEWSLETTER_TEST_DATABASE_URL=
